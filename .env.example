# Example environment values; the application does not auto-load this file.
# Export them in your shell or use an environment-variable manager.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=survey_system
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Generate a random secret of at least 32 characters for signed session cookies.
SESSION_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Enable only when serving the API over HTTPS.
SESSION_COOKIE_SECURE=false
